// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  content     String?
  category    String
  visibility  String   @default("PUBLIC")
  status      String   @default("DRAFT")
  imageUrl    String?
  githubUrl   String?
  demoUrl     String?
  
  // Case study fields
  challenge   String?
  solution    String?
  impact      String?
  clientName  String?
  timeline    String?
  budgetRange String?

  techStack    TechStack[]
  metrics      Metric[]
  translations ProjectTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectTranslation {
  id          String  @id @default(cuid())
  locale      String  // 'en', 'vi'
  title       String
  description String
  content     String?
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, locale])
}

model TechStack {
  id        String   @id @default(cuid())
  name      String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Metric {
  id        String   @id @default(cuid())
  key       String   // e.g. "Inference Time"
  value     String   // e.g. "12ms"
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Blog {
  id          String   @id @default(cuid())
  slug        String   @unique
  category    String
  visibility  String   @default("PUBLIC")
  status      String   @default("DRAFT")
  views       Int      @default(0)
  imageUrl    String?

  translations BlogTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogTranslation {
  id          String  @id @default(cuid())
  locale      String  // 'en', 'vi'
  title       String
  description String
  content     String?
  blogId      String
  blog        Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@unique([blogId, locale])
}

model ContactSubmission {
  id          String   @id @default(cuid())
  name        String
  email       String
  budget      String?
  description String
  status      String   @default("NEW") // NEW, CONTACTED, CLOSED
  viewed      Boolean  @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  role        String
  company     String?
  content     String
  avatarUrl   String?
  logoUrl     String?
  featured    Boolean  @default(false)
  order       Int      @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsletterSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String   // e.g., "AI System Dev", "Computer Vision", "NLP", "Data Automation"
  tags        String?  // comma-separated tags
  icon        String?  // icon identifier or emoji
  order       Int      @default(0)
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE
  translations ServiceTranslation[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ServiceTranslation {
  id          String  @id @default(cuid())
  locale      String  // 'en', 'vi'
  title       String
  description String
  serviceId   String
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, locale])
}

model Faq {
  id       String   @id @default(cuid())
  question String
  answer   String
  category String?  // e.g., "General", "Services", "Pricing"
  order    Int      @default(0)
  status   String   @default("ACTIVE") // ACTIVE, INACTIVE
  locale   String   @default("en") // 'en', 'vi'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteMetric {
  id          String   @id @default(cuid())
  label       String   // e.g., "Years Experience"
  value       String   // e.g., "12+"
  suffix      String?  // e.g., "%", "x"
  description String?  // e.g., "Production ML systems deployed"
  order       Int      @default(0)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Client {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  websiteUrl String?
  order     Int      @default(0)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Technology {
  id          String   @id @default(cuid())
  name        String
  category    String   // e.g., "ML Frameworks", "Data Engineering", "DevOps", "Languages"
  description String?
  iconUrl     String?
  order       Int      @default(0)
  status      String   @default("ACTIVE")
  translations TechnologyTranslation[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TechnologyTranslation {
  id          String     @id @default(cuid())
  locale      String     // 'en', 'vi'
  name        String
  description String?
  technologyId String
  technology  Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@unique([technologyId, locale])
}

// Editable copy for the public About page. One row per field per locale.
// The i18n JSON stays the source of defaults; these rows override it.
model AboutField {
  id        String   @id @default(cuid())
  key       String   // message path, e.g. "philosophy.data.title"
  locale    String   // 'en', 'vi'
  group     String   // hero | philosophy | timeline | skills | resume
  value     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, locale])
  @@index([locale, group])
}
