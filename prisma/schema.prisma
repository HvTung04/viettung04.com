// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  content     String?
  category    String
  visibility  String   @default("PUBLIC")
  status      String   @default("DRAFT")
  imageUrl    String?
  githubUrl   String?
  demoUrl     String?

  techStack    TechStack[]
  metrics      Metric[]
  translations ProjectTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectTranslation {
  id          String  @id @default(cuid())
  locale      String  // 'en', 'vi'
  title       String
  description String
  content     String?
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, locale])
}

model TechStack {
  id        String   @id @default(cuid())
  name      String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Metric {
  id        String   @id @default(cuid())
  key       String   // e.g. "Inference Time"
  value     String   // e.g. "12ms"
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Blog {
  id          String   @id @default(cuid())
  slug        String   @unique
  category    String
  visibility  String   @default("PUBLIC")
  status      String   @default("DRAFT")
  views       Int      @default(0)
  imageUrl    String?

  translations BlogTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogTranslation {
  id          String  @id @default(cuid())
  locale      String  // 'en', 'vi'
  title       String
  description String
  content     String?
  blogId      String
  blog        Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@unique([blogId, locale])
}
